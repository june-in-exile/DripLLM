# Facilitator (self-hosted TypeScript version: npm run facilitator)
FACILITATOR_URL=http://localhost:8080
FACILITATOR_PORT=8080
FACILITATOR_PRIVATE_KEY=0x...   # Needs Fuji AVAX for gas (four transaction types: deposit/claim/settle/refund)

# Seller's receiving address
LLM_PROVIDER_ADDRESS=0x...

# Seller's receiver-authorizer private key (optional).
# Set = the seller signs claim/refund authorizations itself (spec §2.4);
# unset = signing is delegated to the facilitator, which must then advertise receiverAuthorizer on /supported.
# LLM_PROVIDER_AUTHORIZER_PRIVATE_KEY=0x...

# Buyer agent (needs Fuji USDC; the facilitator pays gas, so no AVAX needed)
AGENT_PRIVATE_KEY=0x...

# Stream billing (spec §5.1). One tick = 1 second; payment is an off-chain voucher, millisecond-level.
CREDIT_PER_TICK_MS=1000
TOPUP_THRESHOLD_MS=300
GRACE_MS=250
PRICE_PER_TICK_ATOMIC=40
MAX_SPEND_ATOMIC=50000

# Payment channel(spec §5.2)
CHANNEL_STORAGE_DIR=.dripllm/channels
DEPOSIT_ATOMIC=50000
DEPOSIT_TOPUP_ATOMIC=5000
WITHDRAW_DELAY_SECS=900
CLAIM_INTERVAL_SECS=60
SETTLE_INTERVAL_SECS=300
REFUND_IDLE_SECS=120
MAX_CLAIMS_PER_BATCH=20

# The facilitator's viem client. viem's default polling for Fuji is 2000ms; lowered to 250ms here.
FACILITATOR_POLLING_MS=250
FACILITATOR_CONFIRMATION_TIMEOUT_MS=30000
